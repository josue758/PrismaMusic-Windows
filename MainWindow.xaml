<Window xmlns:local="clr-namespace:PrismaMusic" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="PrismaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisma Music" Width="1320" Height="850" MinWidth="960" MinHeight="650" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" KeyDown="Shortcuts">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="Shell" Background="Transparent" MouseMove="ShellMouseMove">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image Grid.RowSpan="3" Source="{Binding Source, ElementName=Cover}" Stretch="UniformToFill" Opacity=".14" IsHitTestVisible="False">
      <Image.Effect><BlurEffect Radius="86" KernelType="Gaussian"/></Image.Effect>
    </Image>
    <Border x:Name="ArtworkTint" Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".76">
      <Border.Background>
        <RadialGradientBrush Center=".68,.28" GradientOrigin=".68,.28" RadiusX=".78" RadiusY=".72">
          <GradientStop Color="#705E8CFF" Offset="0"/>
          <GradientStop Color="#365E8CFF" Offset=".45"/>
          <GradientStop Color="#005E8CFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7317161B" Offset="0"/>
        <GradientStop Color="#6417161B" Offset=".5"/>
        <GradientStop Color="#9217161B" Offset="1"/>
      </LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <Grid x:Name="WindowTitleBar" Grid.Row="0" Margin="22,4,12,2" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
        <TextBlock Text="PRISMA MUSIC" FontSize="11" FontWeight="SemiBold" Foreground="#EFFFFFFF"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleBarButton}" Click="MinimizeMainWindow"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Minimizar}">
          <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
        <Button x:Name="MaximizeWindowButton" Style="{StaticResource TitleBarButton}" Click="ToggleMainWindowState"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Maximizar}">
          <TextBlock x:Name="MaximizeWindowGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseMainWindow"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Cerrar}">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="Workspace" Grid.Row="1" Margin="18,4,18,8">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ListeningColumn" Width="330"/></Grid.ColumnDefinitions>
      <Border Padding="8,10,10,10" Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="22">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,0,28">
            <Border Background="#1EFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Width="40" Height="40" CornerRadius="14">
              <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
              <TextBlock x:Name="BrandTitle" Text="PRISMA" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="MUSIC PLAYER" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="LibraryCommands" DockPanel.Dock="Bottom" Margin="4,10,4,2">
            <Button x:Name="CancelScanButton" Content="{local:LocalText Text=Cancelar escaneo}" Click="CancelScan" Visibility="Collapsed" Margin="0,0,0,6"/>
            <Button Content="{local:LocalText Text=↻  Actualizar biblioteca}" Click="Rescan" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
            <Button Content="{local:LocalText Text=⚙  Configuración}" Click="Settings" HorizontalContentAlignment="Left"/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="10,0,4,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{local:LocalText Text=TU BIBLIOTECA}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
            <Button x:Name="NewPlaylistButton" Grid.Column="1" Content="＋" Style="{StaticResource CompactButton}" Click="NewPlaylist"
                    AutomationProperties.Name="{local:LocalText Text=Crear lista}" ToolTip="{local:LocalText Text=Crear lista}" Padding="8,4"/>
          </Grid>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,10">
            <Grid Margin="2,0,2,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{local:LocalText Text=FUENTES}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="{local:LocalText Text=Todas}" Style="{StaticResource CompactButton}" Click="ClearLibrarySource"
                      AutomationProperties.Name="{local:LocalText Text=Mostrar todas las fuentes}" ToolTip="{local:LocalText Text=Mostrar todas las fuentes}" Padding="6,3" Margin="0,0,4,0"/>
              <Button Grid.Column="2" Content="＋" Style="{StaticResource CompactButton}" Click="AddFolder"
                      AutomationProperties.Name="{local:LocalText Text=Añadir carpeta}" ToolTip="{local:LocalText Text=Añadir carpeta}" Padding="7,3"/>
            </Grid>
            <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="LibrarySources"/>
            </ScrollViewer>
            <Button Content="{local:LocalText Text=Conectar NAS}" Click="ConnectNas" Margin="0,5,0,0" HorizontalContentAlignment="Left"
                    AutomationProperties.Name="{local:LocalText Text=Conectar NAS}" ToolTip="{local:LocalText Text=Conectar NAS}"/>
          </StackPanel>
          <ListBox ItemContainerStyle="{StaticResource NavigationItem}" x:Name="Navigation" AutomationProperties.Name="{local:LocalText Text=Secciones de biblioteca}" SelectionChanged="Navigate" Background="Transparent" Foreground="White" BorderThickness="0">
            <ListBoxItem Tag="&#xE8D6;" Content="{local:LocalText Text=Canciones}"/><ListBoxItem Tag="&#xE93C;" Content="{local:LocalText Text=Álbumes}"/><ListBoxItem Tag="&#xE716;" Content="{local:LocalText Text=Artistas}"/>
            <ListBoxItem Tag="&#xEB51;" Content="{local:LocalText Text=Favoritos}"/><ListBoxItem Tag="&#xE8FD;" Content="{local:LocalText Text=Cola}"/><ListBoxItem Tag="&#xE81C;" Content="{local:LocalText Text=Historial}"/><ListBoxItem Tag="&#xE93F;" Content="{local:LocalText Text=Listas}"/>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="24,2,22,0">
        <Border x:Name="LibraryHeader" DockPanel.Dock="Top" Padding="4,12,4,4" Margin="0,0,0,18" CornerRadius="18">
          <DockPanel>
            <Border x:Name="CollectionArtTile" DockPanel.Dock="Left" Width="135" Height="135" Margin="0,0,18,0"
                    CornerRadius="9" Background="#1FFFFFFF" Visibility="Collapsed">
              <Grid ClipToBounds="True">
                <TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="CollectionArt" Stretch="UniformToFill"/>
              </Grid>
            </Border>
            <Button x:Name="BackToCollection" DockPanel.Dock="Right" Content="{local:LocalText Text=‹ Volver}"
                    Click="CloseCollection" Visibility="Collapsed" VerticalAlignment="Top" Margin="8,4,0,0"
                    AutomationProperties.Name="{local:LocalText Text=Volver a la colección}" ToolTip="{local:LocalText Text=Volver a la colección}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CollectionKind" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Visibility="Collapsed"/>
              <TextBlock Text="{local:LocalText Text=TU ESPACIO MUSICAL}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
              <TextBlock x:Name="Heading" Text="{local:LocalText Text=Canciones}" FontSize="38" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="CollectionCount" Foreground="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
              <WrapPanel x:Name="CollectionActions" Visibility="Collapsed" Margin="0,12,0,0">
                <Button Click="PlayCollection" Background="{DynamicResource AccentBrush}"><TextBlock Text="{local:LocalText Text=Reproducir colección}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"/></Button>
                <Button Content="{local:LocalText Text=Aleatorio}" Click="ShuffleCollection"/>
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,13">
          <TextBox x:Name="Search" Style="{StaticResource LibrarySearch}" Height="44" Padding="42,0,14,0" Background="#1AFFFFFF" Foreground="#FFFFFF" CaretBrush="White" BorderBrush="#2AFFFFFF" TextChanged="Filter" ToolTip="{local:LocalText Text=Buscar canción\, artista\, álbum\, género o año}" AutomationProperties.Name="{local:LocalText Text=Buscar música}"/>
          <TextBlock IsHitTestVisible="False" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#C5FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock IsHitTestVisible="False" Text="{local:LocalText Text=Buscar música}" Foreground="#C5FFFFFF" VerticalAlignment="Center" Margin="36,0,0,0">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,13"><ComboBox Style="{StaticResource FilterCombo}" x:Name="PlaylistPicker" Width="145" Margin="0,0,6,0" Visibility="Collapsed" SelectionChanged="SelectPlaylist"/><Button x:Name="OpenRelatedArtist" Content="{local:LocalText Text=Ver artista}" Click="BrowseRelatedArtist" Visibility="Collapsed"/><Button x:Name="OpenRelatedAlbum" Content="{local:LocalText Text=Ver álbum}" Click="BrowseRelatedAlbum" Visibility="Collapsed"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Genre" Width="167" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Género}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Year" Width="142" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Año}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Sort" Width="115" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Orden}">
            <ComboBoxItem Content="{local:LocalText Text=Nombre}"/><ComboBoxItem Content="{local:LocalText Text=Artista}"/><ComboBoxItem Content="{local:LocalText Text=Año}"/>
          </ComboBox>
        </WrapPanel>
                <StackPanel x:Name="QueueTools" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
          <Button Content="↑" Click="MoveQueueUp" AutomationProperties.Name="{local:LocalText Text=Subir en la cola}" ToolTip="{local:LocalText Text=Subir en la cola}"/>
          <Button Content="↓" Click="MoveQueueDown" AutomationProperties.Name="{local:LocalText Text=Bajar en la cola}" ToolTip="{local:LocalText Text=Bajar en la cola}"/>
          <Button Content="{local:LocalText Text=Quitar}" Click="RemoveFromQueue"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
        <StackPanel x:Name="ScanProgressPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,2">
          <ProgressBar x:Name="ScanProgressBar" Height="3" IsIndeterminate="True" Margin="0,0,0,5"/>
          <TextBlock x:Name="ScanProgressText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
        <StackPanel x:Name="GalleryPager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="GalleryPrevious" AutomationProperties.Name="{local:LocalText Text=Anterior}" Content="‹" Click="PreviousGalleryPage" ToolTip="{local:LocalText Text=Anterior}"/>
          <TextBlock x:Name="GalleryPageLabel" Margin="8,0,14,0" VerticalAlignment="Center"/>
          <Button x:Name="GalleryNext" AutomationProperties.Name="{local:LocalText Text=Siguiente}" Content="›" Click="NextGalleryPage" ToolTip="{local:LocalText Text=Siguiente}"/>
        </StackPanel>
        <ListBox x:Name="Rows" AutomationProperties.Name="{local:LocalText Text=Resultados de biblioteca}" Background="Transparent" Foreground="White" BorderThickness="0" MouseDoubleClick="Activate" SelectionChanged="RowsSelectionChanged" ContextMenuOpening="PrepareLibraryTagsMenu" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ContextMenu>
            <ContextMenu Style="{StaticResource PlayerMenu}">
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Editar etiquetas de biblioteca}" Click="EditLibraryTags">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;"/></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.Resources>
<DataTemplate x:Key="SongRow">
              <DockPanel Margin="2,2">
                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="8" Background="#18FFFFFF" Margin="0,0,12,0">
                  <Grid ClipToBounds="True">
                    <local:ArtworkTile Caption="{Binding TileCaption}"/>
                    <Image Loaded="LoadTrackArtwork" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" Foreground="{StaticResource Muted}" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="#C5FFFFFF" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="GalleryCard">
              <StackPanel Width="158" Margin="4,2,8,12">
                <Border Height="158" CornerRadius="14" Background="#20FFFFFF" Margin="0,0,0,10">
                  <Grid ClipToBounds="True">
                    <local:ArtworkTile Caption="{Binding TileCaption}"/>
                    <Image Loaded="LoadGalleryCard" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Footnote}" Foreground="#C5FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.Resources>
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="ItemTemplate" Value="{StaticResource SongRow}"/>
              <Style.Triggers>
                <Trigger Property="Tag" Value="Gallery">
                  <Setter Property="ItemTemplate" Value="{StaticResource GalleryCard}"/>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>

        </ListBox>
      </DockPanel>
      <Border x:Name="Listening" Grid.Column="2" Background="#24FFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1" CornerRadius="24" Padding="18">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,1,0,16">
            <TextBlock Text="{local:LocalText Text=REPRODUCIENDO AHORA}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="{local:LocalText Text=Tu sesión}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
          </StackPanel>
          <Border x:Name="ArtPanel" DockPanel.Dock="Top" Height="270" CornerRadius="18" Background="#14FFFFFF" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <local:ArtworkTile Caption="{Binding Tag, ElementName=Cover}"/>
              <Image x:Name="Cover" Stretch="UniformToFill"/>
              <Border VerticalAlignment="Bottom" Height="94" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00121016" Offset="0"/><GradientStop Color="#A8121016" Offset="1"/>
                </LinearGradientBrush></Border.Background>
              </Border>
              <Button Background="Transparent" Click="Fullscreen" Padding="0" Cursor="Hand"
                      ToolTip="{local:LocalText Text=Pantalla completa}"
                      AutomationProperties.Name="{local:LocalText Text=Pantalla completa}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CoverHitArea" Background="Transparent" CornerRadius="12" BorderThickness="2">
                      <TextBlock x:Name="CoverHint" Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CoverHitArea" Property="BorderBrush" Value="#66FFFFFF"/><Setter TargetName="CoverHint" Property="Visibility" Value="Visible"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CoverHitArea" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CoverHint" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="Now" DockPanel.Dock="Top" Text="{local:LocalText Text=Sin pista}" FontWeight="Bold" FontSize="25" TextTrimming="CharacterEllipsis" Margin="0,17,0,4"/>
          <TextBlock x:Name="Artist" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="AudioFormat" DockPanel.Dock="Top" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,13" TextTrimming="CharacterEllipsis"/>
          <WrapPanel x:Name="ListeningActions" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="{local:LocalText Text=＋ Cola}" Click="Enqueue"/><Button Content="{local:LocalText Text=＋ Lista}" Click="Playlist" AutomationProperties.Name="{local:LocalText Text=Añadir o quitar de la lista seleccionada}" ToolTip="{local:LocalText Text=Añadir o quitar de la lista seleccionada}"/>
            <Button Content="{local:LocalText Text=Artista}" Click="ArtistProfile" AutomationProperties.Name="{local:LocalText Text=Ver perfil del artista}" ToolTip="{local:LocalText Text=Ver perfil del artista}"/>
            <Button Style="{StaticResource CompactButton}" Content="ⓘ" Click="Inspect" AutomationProperties.Name="{local:LocalText Text=Información del archivo}" ToolTip="{local:LocalText Text=Información del archivo}"/>
          </WrapPanel>
          <UniformGrid x:Name="SpectrumView" DockPanel.Dock="Top" Rows="1" Height="28" Margin="0,2,0,12" ToolTip="{local:LocalText Text=Espectro de la pista}" AutomationProperties.Name="{local:LocalText Text=Espectro de diez bandas}"/>
          <Border Background="#252630" BorderBrush="#23FFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,9">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{local:LocalText Text=Letras}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource TransportIcon}" Width="30" Height="30" Content="&#xE721;"
                        Click="LookupLyrics" ToolTip="{local:LocalText Text=Buscar letras}" AutomationProperties.Name="{local:LocalText Text=Buscar letras}"/>
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Lyrics" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
    <Border x:Name="Transport" Grid.Row="2" Margin="16,6,16,12" Background="#F21C1D24" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="TransportArtworkButton" Style="{StaticResource TransportIcon}" Width="50" Height="50" Margin="0,0,10,0"
                  Click="Fullscreen" AutomationProperties.Name="{local:LocalText Text=Pantalla completa}" ToolTip="{local:LocalText Text=Pantalla completa}">
            <Border Width="48" Height="48" CornerRadius="7" ClipToBounds="True">
              <Grid>
                <local:ArtworkTile Caption="{Binding Tag, ElementName=Cover}"/>
                <Image x:Name="TransportCover" Source="{Binding Source, ElementName=Cover}" Stretch="UniformToFill"/>
              </Grid>
            </Border>
          </Button>
          <Button DockPanel.Dock="Right" x:Name="FavoriteToolbarButton" Content="&#xEB51;" Style="{StaticResource TransportIcon}"
                  Click="Favorite" AutomationProperties.Name="{local:LocalText Text=Favorito}" ToolTip="{local:LocalText Text=Favorito}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TransportTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text, ElementName=Artist}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text, ElementName=AudioFormat}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ShuffleButton" Style="{StaticResource TransportIcon}" Content="&#xE8B1;" Click="ToggleShuffle" AutomationProperties.Name="{local:LocalText Text=Aleatorio}" ToolTip="{local:LocalText Text=Aleatorio}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE892;" Click="Previous" AutomationProperties.Name="{local:LocalText Text=Anterior}" ToolTip="{local:LocalText Text=Anterior}"/>
            <Button Style="{StaticResource PrimaryTransport}" x:Name="PlayButton" AutomationProperties.Name="{local:LocalText Text=Reproducir o pausar}" Width="44" Height="38" Margin="5,0" Content="&#xE768;" Click="Toggle" ToolTip="{local:LocalText Text=Reproducir o pausar}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE893;" Click="Next" AutomationProperties.Name="{local:LocalText Text=Siguiente}" ToolTip="{local:LocalText Text=Siguiente}"/>
            <Button x:Name="RepeatButton" Style="{StaticResource TransportIcon}" Content="&#xE8EE;" Click="ToggleRepeat" AutomationProperties.Name="{local:LocalText Text=Repetir}" ToolTip="{local:LocalText Text=Repetir}"/>
          </StackPanel>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeLabel" Text="0:00" TextAlignment="Right" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <Slider Grid.Column="1" Style="{StaticResource TransportSlider}" x:Name="Seek" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="{local:LocalText Text=Posición}"/>
            <TextBlock Grid.Column="2" x:Name="RemainingTimeLabel" Text="−0:00" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StopAfterTrackIndicator" Style="{StaticResource TransportIcon}" Width="30" Content="&#xE71A;"
                    Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Click="ToggleStopAfterTrack"
                    ToolTip="{local:LocalText Text=Cancelar pausa al final de la canción}" AutomationProperties.Name="{local:LocalText Text=Cancelar pausa al final de la canción}"/>
            <Button x:Name="SleepCountdown" Style="{StaticResource TransportIcon}" FontFamily="Segoe UI" Width="Auto" MinWidth="40" Padding="5,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Click="ShowSleepTimer" AutomationProperties.Name="{local:LocalText Text=Temporizador de sueño}" ToolTip="{local:LocalText Text=Temporizador de sueño}"/>
            <Button x:Name="AudioOutputButton" Content="&#xE7F5;" Style="{StaticResource TransportIcon}" Click="ShowAudioOutputMenu" AutomationProperties.Name="{local:LocalText Text=Salida de audio}" ToolTip="{local:LocalText Text=Salida de audio}"/>
            <Button x:Name="ListeningMenuButton" Content="&#xE712;" Style="{StaticResource TransportIcon}" Click="ShowListeningMenu" AutomationProperties.Name="{local:LocalText Text=Más opciones}" ToolTip="{local:LocalText Text=Más opciones}">
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource PlayerMenu}">
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Buscar letras}" Click="LookupLyrics">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BD;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Traducir}" Click="TranslateLyrics">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C1;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Información del archivo}" InputGestureText="Ctrl+I" Click="Inspect">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Editar etiquetas de biblioteca}" Click="EditLibraryTags">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Ver perfil del artista}" Click="ArtistProfile">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE77B;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Modo PiP}" Click="Mini">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A7;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="FullScreenMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Pantalla completa}" InputGestureText="F11" Click="Fullscreen">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE740;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Visualizador}" Click="ShowVisualizer">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9E9;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="CastMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Transmitir a dispositivo}" Click="CastTrack">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE709;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Temporizador de sueño}" Click="ShowSleepTimerFromMenu">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE916;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="StopAfterTrackMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Pausar al final de esta canción}" Click="ToggleStopAfterTrack">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE769;"/></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>
          <Button x:Name="EnableVolumeButton" Content="{local:LocalText Text=Activar volumen}" Click="EnableAdjustableVolume" Visibility="Collapsed"/>
          <StackPanel x:Name="VolumeControls" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource TransportIcon}" Width="30" Height="26" Click="ToggleMute" AutomationProperties.Name="{local:LocalText Text=Silenciar}" ToolTip="{local:LocalText Text=Silenciar}"/>
            <Slider Style="{StaticResource TransportSlider}" x:Name="Volume" Width="83" Minimum="0" Maximum="1" Value=".7" ValueChanged="ChangeVolume" AutomationProperties.Name="{local:LocalText Text=Volumen}"/>
            <TextBlock x:Name="VolumeLabel" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}" Text="{Binding Value, ElementName=Volume, StringFormat={}{0:P0}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="AudioGlow" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0">
      <Border.Background>
        <RadialGradientBrush RadiusX=".48" RadiusY=".55">
          <GradientStop Color="#66FFFFFF" Offset="0"/>
          <GradientStop Color="#22FFFFFF" Offset=".45"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border x:Name="GlassReflection" Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".08">
      <Border.Background>
        <RadialGradientBrush RadiusX=".42" RadiusY=".48">
          <GradientStop Color="#55FFFFFF" Offset="0"/>
          <GradientStop Color="#18FFFFFF" Offset=".35"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
  </Grid>
</Window>
