<Window x:Class="PrismaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisma Music" Width="1160" Height="730" MinWidth="760" MinHeight="490" FontFamily="Segoe UI" FontSize="14" KeyDown="Shortcuts">
  <Grid x:Name="Shell" Background="#161621">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace" Margin="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="13">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="◈  Prisma Music" FontWeight="SemiBold" FontSize="18" Margin="0,2,0,22"/>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="＋  Carpeta" Click="AddFolder" Margin="0,0,0,6"/>
            <Button Content="↻  Actualizar" Click="Rescan" Margin="0,0,0,6"/>
            <Button Content="♫  Demos" Click="AddDemos"/>
          </StackPanel>
          <ListBox x:Name="Navigation" SelectionChanged="Navigate" Background="Transparent" Foreground="White" BorderThickness="0">
            <ListBoxItem Content="Canciones"/><ListBoxItem Content="Álbumes"/><ListBoxItem Content="Artistas"/>
            <ListBoxItem Content="Favoritos"/><ListBoxItem Content="Cola"/><ListBoxItem Content="Historial"/><ListBoxItem Content="Mi lista"/>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="18,0">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Text="Canciones" FontSize="34" FontWeight="SemiBold" Margin="0,3,0,14"/>
        <TextBox x:Name="Search" DockPanel.Dock="Top" Padding="10" TextChanged="Filter" ToolTip="Buscar canción, artista, álbum, género o año" AutomationProperties.Name="Buscar música" Margin="0,0,0,9"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <ComboBox x:Name="Genre" Width="135" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="Género"/>
          <ComboBox x:Name="Year" Width="95" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="Año"/>
          <ComboBox x:Name="Sort" Width="115" SelectionChanged="Filter" AutomationProperties.Name="Orden">
            <ComboBoxItem Content="Nombre"/><ComboBoxItem Content="Artista"/><ComboBoxItem Content="Año"/>
          </ComboBox>
        </WrapPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
        <ListBox x:Name="Rows" Background="#20202D" Foreground="White" BorderThickness="0" MouseDoubleClick="Activate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="9,5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="#B8B4C6" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Border x:Name="Listening" Grid.Column="2" Background="#C9222230" CornerRadius="14" Padding="15">
        <DockPanel>
          <Border x:Name="ArtPanel" DockPanel.Dock="Top" Height="190" CornerRadius="10" Background="#35354B" ClipToBounds="True">
            <Grid><TextBlock Text="♫" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B9ACF6"/><Image x:Name="Cover" Stretch="Uniform"/></Grid>
          </Border>
          <TextBlock x:Name="Now" DockPanel.Dock="Top" Text="Escuchando" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" Margin="0,12,0,3"/>
          <TextBlock x:Name="Artist" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <Button Content="♡" Click="Favorite" ToolTip="Favorito"/>
            <Button Content="＋ Cola" Click="Enqueue"/><Button Content="＋ Lista" Click="Playlist" ToolTip="Añadir o quitar de Mi lista"/>
            <Button Content="ⓘ" Click="Inspect" ToolTip="Información del archivo"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <Button Content="Letras web" Click="LookupLyrics"/>
            <Button Content="Mini" Click="Mini"/>
            <Button Content="⛶" Click="Fullscreen" ToolTip="Pantalla completa"/>
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Lyrics" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="15,8" Margin="18,0,18,14" CornerRadius="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="⏮" Click="Previous" ToolTip="Anterior"/>
          <Button x:Name="PlayButton" Content="▶" Click="Toggle" ToolTip="Reproducir o pausar"/>
          <Button Content="⏭" Click="Next" ToolTip="Siguiente"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" Margin="8,0,16,0"/>
          <TextBlock Text="Vol." Margin="0,0,6,0"/>
          <Slider x:Name="Volume" Width="75" Minimum="0" Maximum="1" Value=".7" ValueChanged="ChangeVolume" AutomationProperties.Name="Volumen"/>
        </StackPanel>
        <Slider x:Name="Seek" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="Posición"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>

