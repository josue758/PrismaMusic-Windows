<Window x:Class="PrismaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisma Music" Width="1280" Height="800" MinWidth="760" MinHeight="490" FontFamily="Segoe UI" FontSize="14" KeyDown="Shortcuts">
  <Grid x:Name="Shell" Background="#161621">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace" Margin="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="13">
        <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,6,0,26">
            <Border Background="#8DDDEB" Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Left">
              <TextBlock Text="♫" FontSize="24" Foreground="#102C3D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Prisma Music" FontWeight="SemiBold" FontSize="20" Margin="0,10,0,2"/>
            <TextBlock Text="BIBLIOTECA LOCAL" FontSize="10" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="＋  Carpeta" Click="AddFolder" Margin="0,0,0,6"/>
            <Button Content="↻  Actualizar" Click="Rescan" Margin="0,0,0,6"/>
            <Button Content="♫  Demos" Click="AddDemos" Margin="0,0,0,6"/><Button Content="⚙  Configuración" Click="Settings"/>
          </StackPanel>
          <ListBox x:Name="Navigation" SelectionChanged="Navigate" Background="Transparent" Foreground="White" BorderThickness="0">
            <ListBoxItem Content="Canciones"/><ListBoxItem Content="Álbumes"/><ListBoxItem Content="Artistas"/>
            <ListBoxItem Content="Favoritos"/><ListBoxItem Content="Cola"/><ListBoxItem Content="Historial"/><ListBoxItem Content="Listas"/>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="18,0">
                <Border DockPanel.Dock="Top" CornerRadius="14" Padding="20,16" Margin="0,0,0,14" BorderBrush="#414141" BorderThickness="1">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#303030"/><GradientStop Color="#252525" Offset="1"/></LinearGradientBrush></Border.Background>
          <StackPanel>
            <TextBlock Text="TU COLECCIÓN" FontSize="11" Foreground="#FFBA9B" FontWeight="SemiBold"/>
            <TextBlock x:Name="Heading" Text="Canciones" FontSize="38" FontWeight="SemiBold" Margin="0,1,0,0"/>
            <TextBlock x:Name="CollectionCount" Foreground="#C1DAE7" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <TextBox x:Name="Search" DockPanel.Dock="Top" Padding="12" Background="#292929" Foreground="#F4F8FB" CaretBrush="White" BorderBrush="#585858" TextChanged="Filter" ToolTip="Buscar canción, artista, álbum, género o año" AutomationProperties.Name="Buscar música" Margin="0,0,0,9"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10"><ComboBox x:Name="PlaylistPicker" Width="145" Margin="0,0,6,0" Visibility="Collapsed" SelectionChanged="SelectPlaylist"/><Button x:Name="NewPlaylistButton" Content="Nueva lista" Click="NewPlaylist" Visibility="Collapsed"/><Button x:Name="BackToCollection" Content="‹ Volver" Click="CloseCollection" Visibility="Collapsed"/>
          <ComboBox x:Name="Genre" Width="135" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="Género"/>
          <ComboBox x:Name="Year" Width="95" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="Año"/>
          <ComboBox x:Name="Sort" Width="115" SelectionChanged="Filter" AutomationProperties.Name="Orden">
            <ComboBoxItem Content="Nombre"/><ComboBoxItem Content="Artista"/><ComboBoxItem Content="Año"/>
          </ComboBox>
        </WrapPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
        <ListBox x:Name="Rows" Background="Transparent" Foreground="White" BorderThickness="0" MouseDoubleClick="Activate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="3,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="#A9BDCA" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Border x:Name="Listening" Grid.Column="2" Background="#E62A2A2A" CornerRadius="14" Padding="15">
        <DockPanel>
          <Border x:Name="ArtPanel" DockPanel.Dock="Top" Height="245" CornerRadius="12" Background="#193448" ClipToBounds="True">
            <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3D7591"/><GradientStop Color="#172336" Offset="1"/></LinearGradientBrush></Grid.Background><TextBlock Text="♫" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#80D8EB"/><Image x:Name="Cover" Stretch="Uniform"/></Grid>
          </Border>
          <TextBlock x:Name="Now" DockPanel.Dock="Top" Text="Escuchando" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" Margin="0,12,0,3"/>
          <TextBlock x:Name="Artist" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <Button Content="♡" Click="Favorite" ToolTip="Favorito"/>
            <Button Content="＋ Cola" Click="Enqueue"/><Button Content="＋ Lista" Click="Playlist" ToolTip="Añadir o quitar de la lista seleccionada"/>
            <Button Content="ⓘ" Click="Inspect" ToolTip="Información del archivo"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <Button Content="Letras web" Click="LookupLyrics"/>
            <Button Content="Mini" Click="Mini"/>
            <Button Content="⛶" Click="Fullscreen" ToolTip="Pantalla completa"/>
          </WrapPanel>
          <UniformGrid x:Name="SpectrumView" DockPanel.Dock="Top" Rows="1" Height="43" Margin="0,0,0,12" ToolTip="Espectro de la pista" AutomationProperties.Name="Espectro de diez bandas"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Lyrics" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="15,8" Margin="18,0,18,14" CornerRadius="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="⏮" Click="Previous" ToolTip="Anterior"/>
          <Button x:Name="PlayButton" Background="#FFB28F" Foreground="#241A16" Padding="20,9" Content="▶" Click="Toggle" ToolTip="Reproducir o pausar"/>
          <Button Content="⏭" Click="Next" ToolTip="Siguiente"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" Margin="8,0,16,0"/>
          <TextBlock Text="Vol." Margin="0,0,6,0"/>
          <Slider x:Name="Volume" Width="75" Minimum="0" Maximum="1" Value=".7" ValueChanged="ChangeVolume" AutomationProperties.Name="Volumen"/>
        </StackPanel>
        <Slider x:Name="Seek" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="Posición"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>





