<Window xmlns:local="clr-namespace:PrismaMusic" x:Class="PrismaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisma Music" Width="1220" Height="790" MinWidth="850" MinHeight="580" FontFamily="Segoe UI" FontSize="14" KeyDown="Shortcuts">
  <Grid x:Name="Shell" Background="#161621">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace" Margin="16,12,22,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Padding="4,0,8,0">
        <DockPanel>
                              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="9,9,0,22">
            <Border Background="#C6ACFF" Width="32" Height="32" CornerRadius="8">
              <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#2A1916" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Prisma Music" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="{local:LocalText Text=＋  Carpeta}" Click="AddFolder" Margin="0,0,0,6"/>
            <Button Content="{local:LocalText Text=↻  Actualizar}" Click="Rescan" Margin="0,0,0,6"/>
            <Button Content="♫  Demos" Click="AddDemos" Margin="0,0,0,6"/><Button Content="{local:LocalText Text=⚙  Configuración}" Click="Settings"/>
          </StackPanel>
          <ListBox ItemContainerStyle="{StaticResource NavigationItem}" x:Name="Navigation" SelectionChanged="Navigate" Background="Transparent" Foreground="White" BorderThickness="0">
            <ListBoxItem Tag="&#xE8D6;" Content="{local:LocalText Text=Canciones}"/><ListBoxItem Tag="&#xE93C;" Content="{local:LocalText Text=Álbumes}"/><ListBoxItem Tag="&#xE716;" Content="{local:LocalText Text=Artistas}"/>
            <ListBoxItem Tag="&#xEB51;" Content="{local:LocalText Text=Favoritos}"/><ListBoxItem Tag="&#xE8FD;" Content="{local:LocalText Text=Cola}"/><ListBoxItem Tag="&#xE81C;" Content="{local:LocalText Text=Historial}"/><ListBoxItem Tag="&#xE93F;" Content="{local:LocalText Text=Listas}"/>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="16,0,24,0">
                        <StackPanel DockPanel.Dock="Top" Margin="2,15,0,19">
          <TextBlock x:Name="Heading" Text="{local:LocalText Text=Canciones}" FontSize="40" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="CollectionCount" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBox x:Name="Search" Padding="36,10,12,10" Background="#29272B" Foreground="#F4F0F3" CaretBrush="White" BorderBrush="#555056" TextChanged="Filter" ToolTip="{local:LocalText Text=Buscar canción\, artista\, álbum\, género o año}" AutomationProperties.Name="{local:LocalText Text=Buscar música}"/>
          <TextBlock IsHitTestVisible="False" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#B6ADBD" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock IsHitTestVisible="False" Text="{local:LocalText Text=Buscar música}" Foreground="#B6ADBD" VerticalAlignment="Center" Margin="36,0,0,0">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10"><ComboBox Style="{StaticResource FilterCombo}" x:Name="PlaylistPicker" Width="145" Margin="0,0,6,0" Visibility="Collapsed" SelectionChanged="SelectPlaylist"/><Button x:Name="NewPlaylistButton" Content="{local:LocalText Text=Nueva lista}" Click="NewPlaylist" Visibility="Collapsed"/><Button x:Name="BackToCollection" Content="{local:LocalText Text=‹ Volver}" Click="CloseCollection" Visibility="Collapsed"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Genre" Width="167" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Género}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Year" Width="142" Margin="0,0,6,0" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Año}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Sort" Width="115" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Orden}">
            <ComboBoxItem Content="{local:LocalText Text=Nombre}"/><ComboBoxItem Content="{local:LocalText Text=Artista}"/><ComboBoxItem Content="{local:LocalText Text=Año}"/>
          </ComboBox>
        </WrapPanel>
                <StackPanel x:Name="QueueTools" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
          <Button Content="↑" Click="MoveQueueUp" ToolTip="{local:LocalText Text=Subir en la cola}"/>
          <Button Content="↓" Click="MoveQueueDown" ToolTip="{local:LocalText Text=Bajar en la cola}"/>
          <Button Content="{local:LocalText Text=Quitar}" Click="RemoveFromQueue"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
        <ListBox x:Name="Rows" Background="Transparent" Foreground="White" BorderThickness="0" MouseDoubleClick="Activate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="3,2">
                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="7" Background="#342D3D" Margin="0,0,11,0">
                  <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#D0B9F5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="#A9BDCA" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Border x:Name="Listening" Grid.Column="2" Background="#E623202B" BorderBrush="#41384C" BorderThickness="1" CornerRadius="16" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{local:LocalText Text=Escuchando}" Foreground="#D0B9F5" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Border x:Name="ArtPanel" DockPanel.Dock="Top" Height="254" CornerRadius="12" Background="#30232C" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#684CB5"/><GradientStop Color="#302048" Offset=".58"/><GradientStop Color="#201D34" Offset="1"/></LinearGradientBrush></Grid.Background>
              <Ellipse Width="246" Height="246" Stroke="#52C9AEFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="192" Height="192" Stroke="#64C9AEFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="132" Height="132" Fill="#32D6BDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="47" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E8D8FF"/>
              <Image x:Name="Cover" Stretch="UniformToFill"/>
            </Grid>
          </Border>
          <TextBlock x:Name="Now" DockPanel.Dock="Top" Text="{local:LocalText Text=Escuchando}" FontWeight="SemiBold" FontSize="23" TextTrimming="CharacterEllipsis" Margin="0,12,0,3"/>
          <TextBlock x:Name="AudioFormat" DockPanel.Dock="Top" Foreground="#FFB397" FontSize="11" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="Artist" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <Button Style="{StaticResource CompactButton}" Content="♡" Click="Favorite" ToolTip="{local:LocalText Text=Favorito}"/>
            <Button Content="{local:LocalText Text=＋ Cola}" Click="Enqueue"/><Button Content="{local:LocalText Text=＋ Lista}" Click="Playlist" ToolTip="{local:LocalText Text=Añadir o quitar de la lista seleccionada}"/>
            <Button Style="{StaticResource CompactButton}" Content="ⓘ" Click="Inspect" ToolTip="{local:LocalText Text=Información del archivo}"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="{local:LocalText Text=Letras web}" Click="LookupLyrics"/>
            <Button x:Name="CastButton" Content="{local:LocalText Text=Transmitir}" Click="CastTrack"/>
            <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Click="ShowListeningMenu" ToolTip="{local:LocalText Text=Más opciones}">
              <Button.ContextMenu>
                <ContextMenu Background="#322B3C" Foreground="#F4F0F3">
                  <MenuItem Header="{local:LocalText Text=Traducir}" Click="TranslateLyrics"/>
                  <MenuItem Header="{local:LocalText Text=Artista}" Click="ArtistProfile"/>
                  <MenuItem Header="Mini" Click="Mini"/>
                  <MenuItem Header="{local:LocalText Text=Pantalla completa}" Click="Fullscreen"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </WrapPanel>
          <UniformGrid x:Name="SpectrumView" DockPanel.Dock="Top" Rows="1" Height="28" Margin="0,2,0,12" ToolTip="{local:LocalText Text=Espectro de la pista}" AutomationProperties.Name="{local:LocalText Text=Espectro de diez bandas}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Lyrics" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#25212D" BorderBrush="#42394F" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Slider Style="{StaticResource TransportSlider}" x:Name="Seek" Grid.ColumnSpan="3" Margin="0,0,0,6" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="{local:LocalText Text=Posición}"/>
        <TextBlock Grid.Row="1" x:Name="TimeLabel" Text="0:00 / 0:00" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ShuffleButton" Style="{StaticResource CompactButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8B1;" Click="ToggleShuffle" ToolTip="{local:LocalText Text=Aleatorio}"/>
          <Button Style="{StaticResource CompactButton}" Content="⏮" Click="Previous" ToolTip="{local:LocalText Text=Anterior}"/>
          <Button x:Name="PlayButton" Background="#C6ACFF" Foreground="#201735" Width="48" Height="38" Padding="0" Content="▶" Click="Toggle" ToolTip="{local:LocalText Text=Reproducir o pausar}"/>
          <Button Style="{StaticResource CompactButton}" Content="⏭" Click="Next" ToolTip="{local:LocalText Text=Siguiente}"/>
          <Button x:Name="RepeatButton" Style="{StaticResource CompactButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8EE;" Click="ToggleRepeat" ToolTip="{local:LocalText Text=Repetir}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <Slider Style="{StaticResource TransportSlider}" x:Name="Volume" Width="94" Minimum="0" Maximum="1" Value=".7" ValueChanged="ChangeVolume" AutomationProperties.Name="{local:LocalText Text=Volumen}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

