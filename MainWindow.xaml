<Window xmlns:local="clr-namespace:PrismaMusic" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="PrismaMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisma Music" Icon="Assets/PrismaMusic.ico" Width="1320" Height="850" MinWidth="960" MinHeight="650" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" KeyDown="Shortcuts">
  <Window.Resources>
    <local:LibraryTrackMatches x:Key="LibraryTrackMatches"/>
    <Style x:Key="VisualizerIcon" TargetType="Path">
      <Setter Property="Data" Value="M 0,6 H 3 L 5,2 L 8,10 L 11,0 L 14,8 L 16,6 H 19"/>
      <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="Shell" Background="Transparent" MouseMove="ShellMouseMove">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="AmbientArtwork" Grid.RowSpan="3" Source="{Binding Source, ElementName=Cover}" Stretch="UniformToFill" Opacity=".14" IsHitTestVisible="False">
      <Image.Effect><BlurEffect Radius="86" KernelType="Gaussian"/></Image.Effect>
    </Image>
    <Border x:Name="ArtworkTint" Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".76">
      <Border.Background>
        <RadialGradientBrush Center=".68,.28" GradientOrigin=".68,.28" RadiusX=".78" RadiusY=".72">
          <GradientStop Color="#705E8CFF" Offset="0"/>
          <GradientStop Color="#365E8CFF" Offset=".45"/>
          <GradientStop Color="#005E8CFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border Background="{DynamicResource NavigationBackdrop}" Grid.RowSpan="3" IsHitTestVisible="False"/>
    <Grid x:Name="WindowTitleBar" Grid.Row="0" Margin="0,0,0,4" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Button x:Name="LibraryBackButton" Style="{StaticResource HeaderAction}" Content="&#xE72B;"
                Click="GoBackInLibrary" IsEnabled="False" Margin="0,0,8,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.Name="{local:LocalText Text=Ir atrás}" ToolTip="{local:LocalText Text=Ir atrás · Alt + ←}"/>
        <Image Source="Assets/PrismaMusic.png" Width="23" Height="23" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Prisma Music" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WorkspaceText}"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <DockPanel Grid.Column="1" MaxWidth="580" Margin="12,0" VerticalAlignment="Center" LastChildFill="True"
                 shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
          <Button Style="{StaticResource CompactButton}" Click="ShowVisualizer" Height="32" Margin="0,0,4,0"
                  Padding="9,0" AutomationProperties.Name="{local:LocalText Text=Visualizador}"
                  ToolTip="{local:LocalText Text=Visualizador en pantalla completa · F12}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource VisualizerIcon}" Margin="0,0,6,0"/>
              <TextBlock Text="{local:LocalText Text=Visualizador}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="LyricsHeaderButton" Style="{StaticResource HeaderAction}" Content="&#xE8BD;" Click="ToggleLyricsView"
                  AutomationProperties.Name="{local:LocalText Text=Mostrar letras}" ToolTip="{local:LocalText Text=Mostrar letras}"/>
          <Button x:Name="QueueHeaderButton" Style="{StaticResource HeaderAction}" Content="&#xE8FD;" Click="ToggleQueueView"
                  AutomationProperties.Name="{local:LocalText Text=Ver cola de reproducción}" ToolTip="{local:LocalText Text=Ver cola de reproducción}"/>
          <Button x:Name="InfoHeaderButton" Style="{StaticResource HeaderAction}" Content="&#xE946;" Click="ToggleInfoView"
                  AutomationProperties.Name="{local:LocalText Text=Mostrar información}" ToolTip="{local:LocalText Text=Mostrar información}"/>
        </StackPanel>
        <Grid>
          <TextBox x:Name="Search" Style="{StaticResource LibrarySearch}" Height="33" Padding="36,0,36,0" Background="{DynamicResource TitleSearchSurface}" Foreground="{DynamicResource WorkspaceText}" CaretBrush="{DynamicResource WorkspaceText}" BorderBrush="{DynamicResource WorkspaceStroke}" TextChanged="SearchTextChanged" ToolTip="{local:LocalText Text=Buscar canción\, artista\, álbum\, género o año}" AutomationProperties.Name="{local:LocalText Text=Buscar música}"/>
          <TextBlock IsHitTestVisible="False" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WorkspaceMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock IsHitTestVisible="False" Text="{local:LocalText Text=Buscar música}" Foreground="{DynamicResource WorkspaceMuted}" VerticalAlignment="Center" Margin="36,0,0,0">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <Button Content="&#xE711;" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,3,0"
                  Click="ClearLibrarySearch" AutomationProperties.Name="{local:LocalText Text=Limpiar búsqueda}" ToolTip="{local:LocalText Text=Limpiar búsqueda}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TransportIcon}">
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
      </DockPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="UpdateAvailableButton" Style="{StaticResource CompactButton}" Click="OpenUpdateDialog"
                Visibility="Collapsed" Height="29" Margin="0,8,6,0" Padding="8,2" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"
                Content="{local:LocalText Text=Actualizar}"
                ToolTip="{local:LocalText Text=Hay una actualización disponible}"
                AutomationProperties.Name="{local:LocalText Text=Hay una actualización disponible}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleBarButton}" Click="MinimizeMainWindow"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Minimizar}">
          <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
        <Button x:Name="MaximizeWindowButton" Style="{StaticResource TitleBarButton}" Click="ToggleMainWindowState"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Maximizar}">
          <TextBlock x:Name="MaximizeWindowGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
        <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseMainWindow"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:LocalText Text=Cerrar}">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
        </Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="Workspace" Grid.Row="1" Margin="16,5,16,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ListeningColumn" Width="330"/></Grid.ColumnDefinitions>
      <Border Margin="0,0,10,0" Padding="7,10,7,7" CornerRadius="12" Background="{DynamicResource SidebarSurface}"
              BorderThickness="1" BorderBrush="{DynamicResource WorkspaceStroke}">
        <DockPanel>
          <StackPanel x:Name="LibraryCommands" DockPanel.Dock="Bottom" Margin="4,10,4,2">
            <Button Click="Rescan" Margin="0,0,0,2" AutomationProperties.Name="{local:LocalText Text=Actualizar biblioteca}" Style="{StaticResource FluentNavigationButton}" Background="Transparent">
              <DockPanel>
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/>
                <TextBlock Text="{local:LocalText Text=Actualizar}"/>
              </DockPanel>
            </Button>
            <Button Click="Settings" AutomationProperties.Name="{local:LocalText Text=Configuración}" Style="{StaticResource FluentNavigationButton}" Background="Transparent">
              <DockPanel>
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/>
                <TextBlock Text="{local:LocalText Text=Configuración}"/>
              </DockPanel>
            </Button>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource LyricsScroll}">
            <StackPanel>
              <TextBlock Text="{local:LocalText Text=Biblioteca}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"
                         FontSize="12" Margin="10,0,0,6"/>
              <ListBox ItemContainerStyle="{StaticResource NavigationItem}" x:Name="Navigation" SelectedValuePath="Uid"
                       AutomationProperties.Name="{local:LocalText Text=Secciones de biblioteca}" SelectionChanged="Navigate"
                       Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBoxItem x:Name="HomeNavigation" Uid="8" Tag="&#xE80F;" Content="{local:LocalText Text=Inicio}"/>
                <ListBoxItem Uid="0" Tag="&#xE8D6;" Content="{local:LocalText Text=Canciones}"/>
                <ListBoxItem Uid="1" Tag="&#xE93C;" Content="{local:LocalText Text=Álbumes}"/>
                <ListBoxItem Uid="2" Tag="&#xE716;" Content="{local:LocalText Text=Artistas}"/>
                <ListBoxItem Uid="3" Tag="&#xEB51;" Content="{local:LocalText Text=Favoritos}" Margin="3,10,3,2"/>
                <ListBoxItem Uid="5" Tag="&#xE81C;" Content="{local:LocalText Text=Historial}"/>
                <ListBoxItem Uid="6" Tag="&#xE93F;" Content="{local:LocalText Text=Listas}"/>
                <ListBoxItem x:Name="LosslessNavigation" Uid="7" Tag="&#xE9E9;" Content="{local:LocalText Text=Sin pérdida}"/>
                <ListBoxItem Uid="4" Tag="&#xE8FD;" Content="{local:LocalText Text=Cola}"/>
              </ListBox>
              <Border Height="1" Background="{DynamicResource WorkspaceStroke}" Margin="8,12,8,8"/>
              <Grid Margin="8,0,3,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{local:LocalText Text=Fuentes}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{local:LocalText Text=Todas}" Style="{StaticResource CompactButton}" Click="ClearLibrarySource"
                        AutomationProperties.Name="{local:LocalText Text=Mostrar todas las fuentes}" ToolTip="{local:LocalText Text=Mostrar todas las fuentes}" Padding="6,3" Margin="0,0,2,0"/>
                <Button Grid.Column="2" Content="＋" Style="{StaticResource CompactButton}" Click="AddFolder"
                        AutomationProperties.Name="{local:LocalText Text=Añadir carpeta}" ToolTip="{local:LocalText Text=Añadir carpeta}" Padding="7,3"/>
              </Grid>
              <ItemsControl x:Name="LibrarySources" Margin="3,0"/>
              <Button Content="{local:LocalText Text=Conectar NAS}" Click="ConnectNas" Style="{StaticResource FluentNavigationButton}"
                      Padding="10,7" Margin="3,3,3,0" Background="Transparent" AutomationProperties.Name="{local:LocalText Text=Conectar NAS}"/>
              <Button x:Name="NewPlaylistButton" Content="{local:LocalText Text=Crear lista}" Style="{StaticResource FluentNavigationButton}" Click="NewPlaylist"
                      AutomationProperties.Name="{local:LocalText Text=Crear lista}" Background="Transparent" Padding="10,7" Margin="3,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource WorkspaceSurface}" BorderBrush="{DynamicResource WorkspaceStroke}"
              BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"/>
      <DockPanel Grid.Column="1" Margin="20,5,20,12">
        <Border x:Name="LibraryHeader" DockPanel.Dock="Top" Padding="4,12,4,4" Margin="0,0,0,15" CornerRadius="12">
          <DockPanel>
            <Border x:Name="CollectionArtTile" DockPanel.Dock="Left" Width="135" Height="135" Margin="0,0,18,0"
                    CornerRadius="9" Background="#1FFFFFFF" Visibility="Collapsed">
              <Grid ClipToBounds="True">
                <TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="CollectionArt" Stretch="UniformToFill"/>
              </Grid>
            </Border>
            <Button x:Name="BackToCollection" DockPanel.Dock="Right" Content="{local:LocalText Text=‹ Volver}"
                    Click="CloseCollection" Visibility="Collapsed" VerticalAlignment="Top" Margin="8,4,0,0"
                    AutomationProperties.Name="{local:LocalText Text=Volver a la colección}" ToolTip="{local:LocalText Text=Volver a la colección}"/>
            <Button x:Name="LibraryImportCommand" DockPanel.Dock="Right" Click="AddFolder" VerticalAlignment="Top"
                    Margin="8,5,0,0" AutomationProperties.Name="{local:LocalText Text=Añadir música}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="{local:LocalText Text=Añadir música}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CollectionKind" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Visibility="Collapsed"/>
              <TextBlock x:Name="Heading" Text="{local:LocalText Text=Canciones}" FontSize="38" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="CollectionCount" Foreground="{DynamicResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
              <WrapPanel x:Name="CollectionActions" Visibility="Collapsed" Margin="0,12,0,0">
                <Button Click="PlayCollection" Background="{DynamicResource AccentBrush}"><TextBlock Text="{local:LocalText Text=Reproducir colección}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"/></Button>
                <Button Content="{local:LocalText Text=Aleatorio}" Click="ShuffleCollection"/>
                <Button x:Name="ArtistOverviewButton" Content="{local:LocalText Text=Ver perfil}" Click="ShowArtistOverview" Visibility="Collapsed"/>
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <DockPanel x:Name="LibraryFilterBar" DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="LibraryMenuButton" DockPanel.Dock="Right" Content="&#xE712;" Style="{StaticResource TransportIcon}"
                  VerticalAlignment="Top" Click="ShowLibraryMenu" AutomationProperties.Name="{local:LocalText Text=Opciones de biblioteca}" ToolTip="{local:LocalText Text=Opciones de biblioteca}">
            <Button.ContextMenu>
              <ContextMenu Style="{StaticResource PlayerMenu}">
                <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Exportar lista}" Click="ExportCurrentPlaylist">
                  <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A5;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Exportar biblioteca}" Click="ExportLibrary">
                  <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UndoBatchTagsMenu" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Deshacer edición por lotes}" Click="UndoBatchTags"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <WrapPanel><ComboBox Style="{StaticResource FilterCombo}" x:Name="PlaylistPicker" Width="145" Margin="0,0,6,6" Visibility="Collapsed" SelectionChanged="SelectPlaylist"/><Button x:Name="OpenRelatedArtist" Content="{local:LocalText Text=Ver artista}" Click="BrowseRelatedArtist" Visibility="Collapsed"/><Button x:Name="OpenRelatedAlbum" Content="{local:LocalText Text=Ver álbum}" Click="BrowseRelatedAlbum" Visibility="Collapsed"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="ArtistFilter" Width="146" Margin="0,0,6,6" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Artista}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Genre" Width="165" Margin="0,0,6,6" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Género}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Year" Width="139" Margin="0,0,6,6" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Año}"/>
          <ComboBox Style="{StaticResource FilterCombo}" x:Name="Sort" Width="110" Margin="0,0,0,6" SelectionChanged="Filter" AutomationProperties.Name="{local:LocalText Text=Orden}">
            <ComboBoxItem Content="{local:LocalText Text=Nombre}"/><ComboBoxItem Content="{local:LocalText Text=Artista}"/><ComboBoxItem Content="{local:LocalText Text=Año}"/><ComboBoxItem Content="{local:LocalText Text=Álbum}"/>
          </ComboBox>
          </WrapPanel>
        </DockPanel>
                <StackPanel x:Name="QueueTools" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
          <Button Content="↑" Click="MoveQueueUp" AutomationProperties.Name="{local:LocalText Text=Subir en la cola}" ToolTip="{local:LocalText Text=Subir en la cola}"/>
          <Button Content="↓" Click="MoveQueueDown" AutomationProperties.Name="{local:LocalText Text=Bajar en la cola}" ToolTip="{local:LocalText Text=Bajar en la cola}"/>
          <Button Content="{local:LocalText Text=Quitar}" Click="RemoveFromQueue"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
          <Button x:Name="RetryTrackButton" Content="{local:LocalText Text=Reintentar pista}" Click="RetryNetworkTrack"
                  HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,4,0,0"/>
          <Button x:Name="ScanReportButton" Content="{local:LocalText Text=Ver informe del escaneo}" Click="ShowScanReport"
                  HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,4,0,0"/>
        </StackPanel>
        <Border x:Name="ScanProgressPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,2"
                Padding="12,10" Background="{DynamicResource SettingsCard}" BorderBrush="{DynamicResource WorkspaceStroke}"
                CornerRadius="8" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="CancelScanButton" DockPanel.Dock="Right" Content="{local:LocalText Text=Cancelar escaneo}"
                      Style="{StaticResource CompactButton}" Click="CancelScan" Visibility="Collapsed" Padding="8,4"/>
              <TextBlock Text="{local:LocalText Text=Escaneando biblioteca}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ProgressBar x:Name="ScanProgressBar" Height="3" IsIndeterminate="True" Margin="0,0,0,7"
                         Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="ScanProgressText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="GalleryPager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="GalleryPrevious" AutomationProperties.Name="{local:LocalText Text=Anterior}" Content="‹" Click="PreviousGalleryPage" ToolTip="{local:LocalText Text=Anterior}"/>
          <TextBlock x:Name="GalleryPageLabel" Margin="8,0,14,0" VerticalAlignment="Center"/>
          <Button x:Name="GalleryNext" AutomationProperties.Name="{local:LocalText Text=Siguiente}" Content="›" Click="NextGalleryPage" ToolTip="{local:LocalText Text=Siguiente}"/>
        </StackPanel>
        <TextBlock x:Name="LosslessNotice" DockPanel.Dock="Top" Visibility="Collapsed" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource WorkspaceStroke}" BorderThickness="0,0,0,1"
                Margin="2,5,2,1" Padding="17,3,22,7" IsHitTestVisible="False">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding WideLibraryColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    <Condition Binding="{Binding Tag, ElementName=Rows}" Value="{x:Null}"/>
                    <Condition Binding="{Binding HasItems, ElementName=Rows}" Value="True"/>
                    <Condition Binding="{Binding Visibility, ElementName=Rows}" Value="Visible"/>
                    <Condition Binding="{Binding Visibility, ElementName=HomeView}" Value="Collapsed"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" Margin="8,0,3,0"
                       Text="{local:LocalText Text=Duración}" FontSize="11" Foreground="{DynamicResource Muted}"/>
            <TextBlock DockPanel.Dock="Right" Width="118" Margin="10,0,4,0"
                       Text="{local:LocalText Text=Formato}" FontSize="11" Foreground="{DynamicResource Muted}"
                       Visibility="{DynamicResource TrackQualityVisibility}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowAlbumColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Width="180" Margin="8,0" Text="{local:LocalText Text=Álbum}" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock Width="48" Margin="8,0" TextAlignment="Right"
                         Text="{local:LocalText Text=Año}" FontSize="11" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <TextBlock Text="{local:LocalText Text=Canción}" Margin="54,0,0,0" FontSize="11" Foreground="{DynamicResource Muted}"/>
          </DockPanel>
        </Border>
        <Border Background="Transparent" Padding="2">
        <Grid>
        <ScrollViewer x:Name="HomeView" Style="{StaticResource LyricsScroll}" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="HomeContent" Margin="2,0,6,8"/>
        </ScrollViewer>
        <ScrollViewer x:Name="ArtistView" Style="{StaticResource LyricsScroll}" Visibility="Collapsed" PreviewKeyDown="MoveBetweenArtistSections"
                      AutomationProperties.HelpText="{local:LocalText Text=Ctrl+Arriba abre canciones. Ctrl+Abajo abre álbumes.}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ArtistContent" Margin="2,0,8,18"/>
        </ScrollViewer>
        <ListBox x:Name="Rows" AutomationProperties.Name="{local:LocalText Text=Resultados de biblioteca}" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" SizeChanged="GalleryViewportChanged" MouseDoubleClick="Activate" PreviewMouseLeftButtonUp="ArtistGalleryPointerUp" SelectionChanged="RowsSelectionChanged" ContextMenuOpening="PrepareLibraryTagsMenu" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ContextMenu>
            <ContextMenu Style="{StaticResource PlayerMenu}">
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Reproducir ahora}" Click="PlaySelectedSong">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Reproducir a continuación}" Click="PlayNextInQueue">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8FD;"/></MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Ver álbum}" Click="BrowseRelatedAlbum">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE93C;"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Ver artista}" Click="BrowseRelatedArtist">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE716;"/></MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Información del archivo}" Click="Inspect">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Editar etiquetas de biblioteca}" Click="EditLibraryTags">
                <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;"/></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.Resources>
            <Style x:Key="WideTrackFact" TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="Margin" Value="8,0"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAlbumColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
            <DataTemplate x:Key="SongRow">
              <DockPanel Margin="2,2">
                <Border DockPanel.Dock="Left" Width="{DynamicResource SongThumbnailSize}" Height="{DynamicResource SongThumbnailSize}" CornerRadius="7" Background="#18FFFFFF" Margin="0,0,12,0">
                  <Grid ClipToBounds="True">
                    <local:ArtworkTile Caption="{Binding TileCaption}"/>
                    <Image Loaded="LoadTrackArtwork" DataContextChanged="TrackArtworkChanged" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" Foreground="{DynamicResource Muted}" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,3,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LibraryFormatLabel}" Visibility="{DynamicResource TrackQualityVisibility}"
                           Foreground="{DynamicResource Muted}" MaxWidth="145" TextTrimming="CharacterEllipsis" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0" ToolTip="{Binding FormatLabel}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WideLibraryColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                          <Setter Property="Width" Value="118"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                           Style="{StaticResource WideTrackFact}" ToolTip="{local:LocalText Text=Año}">
                  <TextBlock.Text>
                    <Binding Path="Tracks[0].Year" StringFormat="{}{0:0;;}"/>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Width="180" Text="{Binding Tracks[0].Album}" Style="{StaticResource WideTrackFact}"
                           ToolTip="{Binding Tracks[0].Album}"/>
                <StackPanel VerticalAlignment="Center">
                  <DockPanel>
                    <TextBlock Text="{Binding AlbumPosition}" Foreground="{DynamicResource Muted}"
                               FontSize="11" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Margin" Value="0,0,8,0"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AlbumPosition}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               ToolTip="{local:LocalText Text=Reproduciendo ahora}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Value="True">
                              <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource LibraryTrackMatches}">
                                  <Binding Path="Tracks[0].Path"/>
                                  <Binding Path="CurrentTrackPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                              </DataTrigger.Binding>
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Tracks[0].Artist}" Foreground="{DynamicResource Muted}"
                             TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding AlbumAndYear}" Foreground="{DynamicResource Muted}" ToolTip="{Binding AlbumAndYear}"
                             TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WideLibraryColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding AlbumAndYear}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="GalleryCard">
              <StackPanel Width="{DynamicResource GalleryTileSize}" Margin="2,2,2,4">
                <Border Height="{DynamicResource GalleryTileSize}" CornerRadius="8" Background="#20FFFFFF" Margin="0,0,0,10">
                  <Grid ClipToBounds="True" SizeChanged="RoundGalleryArtwork">
                    <local:ArtworkTile Caption="{Binding TileCaption}"/>
                    <Image Loaded="LoadGalleryCard" DataContextChanged="GalleryArtworkChanged" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Footnote}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.Resources>
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="ItemTemplate" Value="{StaticResource SongRow}"/>
              <Style.Triggers>
                <Trigger Property="Tag" Value="Gallery">
                  <Setter Property="ItemTemplate" Value="{StaticResource GalleryCard}"/>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>

        </ListBox>
        <StackPanel x:Name="EmptyLibraryView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="14">
          <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyLibraryTitle" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,5"/>
          <TextBlock x:Name="EmptyLibraryDetail" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="EmptyLibraryAction" HorizontalAlignment="Center" Margin="0,12,0,0" Click="RunEmptyLibraryAction"/>
        </StackPanel>
        </Grid>
        </Border>
      </DockPanel>
      <Border x:Name="Listening" Grid.Column="2" Background="{DynamicResource ListeningSurface}" BorderBrush="{DynamicResource WorkspaceStroke}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="10,0,0,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderAction}" Content="&#xE711;" Click="ToggleListeningPanel"
                    AutomationProperties.Name="{local:LocalText Text=Plegar panel de reproducción}" ToolTip="{local:LocalText Text=Plegar panel de reproducción}"/>
            <TextBlock x:Name="ListeningPanelTitle" Text="{local:LocalText Text=Reproduciendo ahora}" Foreground="{DynamicResource Ink}"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel x:Name="ListeningTrackSummary" DockPanel.Dock="Top">
          <Border x:Name="ArtPanel" DockPanel.Dock="Top" Height="226" Width="{Binding Height, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Left" CornerRadius="10" Background="{DynamicResource ControlFill}" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <local:ArtworkTile Caption="{Binding Tag, ElementName=Cover}"/>
              <Image x:Name="Cover" Stretch="UniformToFill"/>
              <Button Background="Transparent" Click="Fullscreen" Padding="0" Cursor="Hand"
                      ToolTip="{local:LocalText Text=Sala de escucha · F11}"
                      AutomationProperties.Name="{local:LocalText Text=Sala de escucha}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CoverHitArea" Background="Transparent" CornerRadius="12" BorderThickness="2">
                      <TextBlock x:Name="CoverHint" Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CoverHitArea" Property="BorderBrush" Value="#66FFFFFF"/><Setter TargetName="CoverHint" Property="Visibility" Value="Visible"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CoverHitArea" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CoverHint" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="Now" DockPanel.Dock="Top" Text="{local:LocalText Text=Sin pista}" FontWeight="Bold" FontSize="25" TextTrimming="CharacterEllipsis" Margin="0,17,0,4"/>
          <TextBlock x:Name="Artist" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="AudioFormat" DockPanel.Dock="Top" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,13" TextTrimming="CharacterEllipsis"/>
          <WrapPanel x:Name="ListeningActions" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="{local:LocalText Text=＋ Cola}" Click="Enqueue" AutomationProperties.Name="{local:LocalText Text=Añadir a la cola}" ToolTip="{local:LocalText Text=Añadir a la cola}"/>
            <Button Content="{local:LocalText Text=＋ Lista}" Click="Playlist" AutomationProperties.Name="{local:LocalText Text=Añadir o quitar de la lista seleccionada}" ToolTip="{local:LocalText Text=Añadir o quitar de la lista seleccionada}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE77B;" Click="ArtistProfile" AutomationProperties.Name="{local:LocalText Text=Ver perfil del artista}" ToolTip="{local:LocalText Text=Ver perfil del artista}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE946;" Click="Inspect" AutomationProperties.Name="{local:LocalText Text=Información del archivo}" ToolTip="{local:LocalText Text=Información del archivo}"/>
          </WrapPanel>
          <UniformGrid x:Name="SpectrumView" DockPanel.Dock="Top" Rows="1" Height="28" Margin="0,2,0,12" ToolTip="{local:LocalText Text=Espectro de la pista}" AutomationProperties.Name="{local:LocalText Text=Espectro de diez bandas}"/>
          </StackPanel>
          <TabControl x:Name="ListeningTabs" SelectionChanged="ListeningTabChanged" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0">
            <TabItem Header="{local:LocalText Text=Letras}" Style="{StaticResource ListeningTab}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource TransportIcon}" Width="30" Height="30" Content="&#xE721;"
                        Click="LookupLyrics" ToolTip="{local:LocalText Text=Buscar letras}" AutomationProperties.Name="{local:LocalText Text=Buscar letras}"/>
              </Grid>
              <ScrollViewer Style="{StaticResource LyricsScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Lyrics" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
              </ScrollViewer>
            </DockPanel>
            </TabItem>
            <TabItem Header="{local:LocalText Text=Cola}" Style="{StaticResource ListeningTab}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                  <TextBlock x:Name="SideQueueCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="{local:LocalText Text=A continuación}" FontWeight="SemiBold"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="8,6">
                  <Button x:Name="UndoQueueButton" DockPanel.Dock="Right" Margin="5,0,0,0"
                          Content="{local:LocalText Text=Deshacer}" Click="UndoQueueRemoval" IsEnabled="False"/>
                  <TextBlock x:Name="QueueRemovalNotice" Visibility="Collapsed" VerticalAlignment="Center"
                             Text="{local:LocalText Text=Canción quitada de la cola.}" TextWrapping="Wrap"
                             AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <Grid>
                  <ListBox x:Name="SideQueue" AutomationProperties.Name="{local:LocalText Text=Cola}" Background="Transparent"
                           Foreground="{DynamicResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
            <Style x:Key="WideTrackFact" TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="Margin" Value="8,0"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding WideLibraryColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
                      <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="QueueDragStart"/>
                        <EventSetter Event="PreviewMouseMove" Handler="QueueDragMove"/>
                        <EventSetter Event="DragOver" Handler="QueueDragOver"/>
                        <EventSetter Event="Drop" Handler="QueueDrop"/>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#10FFFFFF" CornerRadius="7" Padding="8">
                          <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource QueueRowButton}" Content="&#xE74A;" Click="MoveSideQueueUp"
                                        AutomationProperties.Name="{local:LocalText Text=Subir en la cola}" ToolTip="{local:LocalText Text=Subir en la cola}"/>
                                <Button Style="{StaticResource QueueRowButton}" Content="&#xE74B;" Click="MoveSideQueueDown"
                                        AutomationProperties.Name="{local:LocalText Text=Bajar en la cola}" ToolTip="{local:LocalText Text=Bajar en la cola}"/>
                                <Button Style="{StaticResource QueueRowButton}" Content="&#xE711;" Click="RemoveSideQueueTrack"
                                        AutomationProperties.Name="{local:LocalText Text=Quitar}" ToolTip="{local:LocalText Text=Quitar}"/>
                              </StackPanel>
                              <TextBlock Text="{Binding DurationLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Margin="0,0,9,0">
                              <Grid>
                                <local:ArtworkTile Caption="{Binding Album}"/>
                                <Image Stretch="UniformToFill" Loaded="LoadQueueArtwork"/>
                              </Grid>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QueueRowButton}" Content="&#xE768;" Click="PlaySideQueueTrack"
                                    AutomationProperties.Name="{local:LocalText Text=Reproducir ahora}" ToolTip="{local:LocalText Text=Reproducir ahora}"/>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                              <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="SideQueueEmpty" IsHitTestVisible="False" Text="{local:LocalText Text=La cola está vacía}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </DockPanel>
            </TabItem>
            <TabItem Header="{local:LocalText Text=Información}" Style="{StaticResource ListeningTab}">
              <ScrollViewer Style="{StaticResource LyricsScroll}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">
                  <TextBlock Text="{local:LocalText Text=Formato de audio}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Text, ElementName=AudioFormat}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                  <Button Content="{local:LocalText Text=Información del archivo}" Click="InspectPlayingTrack" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <Border x:Name="Transport" Grid.Row="2" Margin="16,10,16,12" Background="{DynamicResource TransportSurface}" BorderBrush="{DynamicResource WorkspaceStroke}" BorderThickness="1" CornerRadius="14" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="TransportMetadataColumn" Width="*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*" MinWidth="216"/></Grid.ColumnDefinitions>
        <DockPanel x:Name="TransportMetadata" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="TransportArtworkButton" Style="{StaticResource TransportIcon}" Width="54" Height="54" Margin="0,0,12,0"
                  Click="Fullscreen" AutomationProperties.Name="{local:LocalText Text=Sala de escucha}" ToolTip="{local:LocalText Text=Sala de escucha · F11}">
            <Border Width="52" Height="52" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <local:ArtworkTile Caption="{Binding Tag, ElementName=Cover}"/>
                <Image x:Name="TransportCover" Source="{Binding Source, ElementName=Cover}" Stretch="UniformToFill"/>
              </Grid>
            </Border>
          </Button>
          <Button DockPanel.Dock="Right" x:Name="FavoriteToolbarButton" Content="&#xEB51;" Style="{StaticResource TransportIcon}"
                  Click="Favorite" AutomationProperties.Name="{local:LocalText Text=Favorito}" ToolTip="{local:LocalText Text=Favorito}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TransportTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text, ElementName=Artist}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text, ElementName=AudioFormat}" Visibility="{DynamicResource TrackQualityVisibility}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ShuffleButton" Style="{StaticResource TransportIcon}" Content="&#xE8B1;" Click="ToggleShuffle" AutomationProperties.Name="{local:LocalText Text=Aleatorio}" ToolTip="{local:LocalText Text=Aleatorio}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE892;" Click="Previous" AutomationProperties.Name="{local:LocalText Text=Anterior}" ToolTip="{local:LocalText Text=Anterior}"/>
            <Button Style="{StaticResource PrimaryTransport}" x:Name="PlayButton" AutomationProperties.Name="{local:LocalText Text=Reproducir o pausar}" Width="50" Height="40" Margin="7,0" Content="&#xE768;" Click="Toggle" ToolTip="{local:LocalText Text=Reproducir o pausar}"/>
            <Button Style="{StaticResource TransportIcon}" Content="&#xE893;" Click="Next" AutomationProperties.Name="{local:LocalText Text=Siguiente}" ToolTip="{local:LocalText Text=Siguiente}"/>
            <Button x:Name="RepeatButton" Style="{StaticResource TransportIcon}" Content="&#xE8EE;" Click="ToggleRepeat" AutomationProperties.Name="{local:LocalText Text=Repetir}" ToolTip="{local:LocalText Text=Repetir}"/>
          </StackPanel>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeLabel" Text="0:00" TextAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <Slider Grid.Column="1" Style="{StaticResource TransportSlider}" x:Name="Seek" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="{local:LocalText Text=Posición}"/>
            <TextBlock Grid.Column="2" x:Name="RemainingTimeLabel" Text="−0:00" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="EqualizerToolbarButton" Content="EQ" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                    Style="{StaticResource TransportIcon}" Width="30" Click="OpenEqualizer"
                    AutomationProperties.Name="{local:LocalText Text=Ecualizador}" ToolTip="{local:LocalText Text=Ecualizador}"/>
            <Button x:Name="AudioOutputButton" Content="&#xE7F5;" Style="{StaticResource TransportIcon}" Width="30"
                    Click="ShowAudioOutputMenu" AutomationProperties.Name="{local:LocalText Text=Salida de audio}" ToolTip="{local:LocalText Text=Salida de audio}"/>
            <Button x:Name="CastToolbarButton" Content="&#xE7F4;" Style="{StaticResource TransportIcon}" Width="30" Click="CastTrack"
                    AutomationProperties.Name="{local:LocalText Text=Transmitir (Miracast)}" ToolTip="{local:LocalText Text=Transmitir (Miracast)}"/>
            <Button x:Name="PipToolbarButton" Content="&#xE8A7;" Style="{StaticResource TransportIcon}" Width="30" Click="Mini"
                    AutomationProperties.Name="{local:LocalText Text=Modo PiP}" ToolTip="{local:LocalText Text=Modo PiP}"/>
            <Button x:Name="FullscreenToolbarButton" Content="&#xE740;" Style="{StaticResource TransportIcon}" Width="30"
                    Click="Fullscreen" AutomationProperties.Name="{local:LocalText Text=Sala de escucha}" ToolTip="{local:LocalText Text=Sala de escucha · F11}"/>
            <Button x:Name="ListeningMenuButton" Content="&#xE712;" Style="{StaticResource TransportIcon}" Width="32" Click="ShowListeningMenu" AutomationProperties.Name="{local:LocalText Text=Más opciones}" ToolTip="{local:LocalText Text=Más opciones}">
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource PlayerMenu}">
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Buscar letras}" Click="LookupLyrics">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BD;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Traducir}" Click="TranslateLyrics">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C1;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Información del archivo}" InputGestureText="Ctrl+I" Click="Inspect">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Editar etiquetas de biblioteca}" Click="EditLibraryTags">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Ver perfil del artista}" Click="ArtistProfile">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE77B;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem x:Name="ListeningPanelMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Plegar panel de reproducción}" Click="ToggleListeningPanel">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A1;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Modo PiP}" Click="Mini">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A7;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="FullScreenMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Sala de escucha}" InputGestureText="F11" Click="Fullscreen">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE740;"/></MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Visualizador}" InputGestureText="F12" Click="ShowVisualizer">
                    <MenuItem.Icon><Path Style="{StaticResource VisualizerIcon}"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="CastMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Transmitir a dispositivo}" Click="CastTrack">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE709;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Temporizador de sueño}" Click="ShowSleepTimerFromMenu">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE916;"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="StopAfterTrackMenuItem" Style="{StaticResource PlayerMenuItem}" Header="{local:LocalText Text=Pausar al final de esta canción}" Click="ToggleStopAfterTrack">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE769;"/></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StopAfterTrackIndicator" Style="{StaticResource TransportIcon}" Width="30" Content="&#xE71A;"
                    Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Click="ToggleStopAfterTrack"
                    ToolTip="{local:LocalText Text=Cancelar pausa al final de la canción}" AutomationProperties.Name="{local:LocalText Text=Cancelar pausa al final de la canción}"/>
            <Button x:Name="SleepCountdown" Style="{StaticResource TransportIcon}" FontFamily="Segoe UI" Width="Auto" MinWidth="40" Padding="5,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Click="ShowSleepTimer" AutomationProperties.Name="{local:LocalText Text=Temporizador de sueño}" ToolTip="{local:LocalText Text=Temporizador de sueño}"/>
          </StackPanel>
          <Button x:Name="EnableVolumeButton" Content="{local:LocalText Text=Activar volumen}" Click="EnableAdjustableVolume" Visibility="Collapsed"/>
          <StackPanel x:Name="VolumeControls" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource TransportIcon}" Width="30" Height="26" Click="ToggleMute" AutomationProperties.Name="{local:LocalText Text=Silenciar}" ToolTip="{local:LocalText Text=Silenciar}"/>
            <Slider Style="{StaticResource TransportSlider}" x:Name="Volume" Width="83" Minimum="0" Maximum="1" Value=".7" ValueChanged="ChangeVolume" AutomationProperties.Name="{local:LocalText Text=Volumen}"/>
            <TextBlock x:Name="VolumeLabel" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Muted}" Text="{Binding Value, ElementName=Volume, StringFormat={}{0:P0}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="AudioGlow" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0">
      <Border.Background>
        <RadialGradientBrush RadiusX=".48" RadiusY=".55">
          <GradientStop Color="#66FFFFFF" Offset="0"/>
          <GradientStop Color="#22FFFFFF" Offset=".45"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border x:Name="GlassReflection" Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".08">
      <Border.Background>
        <RadialGradientBrush RadiusX=".42" RadiusY=".48">
          <GradientStop Color="#55FFFFFF" Offset="0"/>
          <GradientStop Color="#18FFFFFF" Offset=".35"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
  </Grid>
</Window>
